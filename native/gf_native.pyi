from typing import Any

import numpy as np
import numpy.typing as npt

class FloatOwner:
    @property
    def pointer(self) -> int: ...
    @property
    def capacity_bytes(self) -> int: ...

def build_info() -> list[tuple[str, str]]: ...
def canonical_json(encoded: bytes, memory_bytes: int, deadline: float) -> bytes: ...
def feature_names(config: bytes, memory_bytes: int, deadline: float) -> list[str]: ...
def validate_input(encoded: bytes, mode: bool | None, memory_bytes: int, deadline: float) -> None: ...
def encode_features(input: bytes, actions: bytes, config: bytes, memory_bytes: int,
                    deadline: float) -> npt.NDArray[np.float64]: ...

class CancelHandle:
    def __init__(self, deadline: float) -> None: ...
    def cancel(self) -> None: ...

class StagingLease:
    def release(self) -> None: ...

class NativeSession:
    def __init__(self, plan: bytes, settings: bytes, deadline: float,
                 wall_deadline: float | None = None, cancel_handle: CancelHandle | None = None) -> None: ...
    def control_summary(self) -> bytes: ...
    def authorize(self, authorization: bytes) -> None: ...
    def next_batch(self, retained_python_bytes: int,
                   consumer_layout: tuple[int, int, int, int]) -> tuple[Any, ...] | None: ...
    def proof(self) -> bytes: ...
    def finalize(self) -> bytes: ...
    def close(self) -> None: ...
    def cancel_handle(self) -> CancelHandle: ...
    def used_bytes(self) -> int: ...
    def peak_bytes(self) -> int: ...
    def reserve_staging(self, memory_bytes: int, scratch_bytes: int) -> StagingLease: ...
    def source_hash(self, path: str) -> str: ...
    def export_staging(self, path: str, offset: int, rows: int, columns: int) -> npt.NDArray[np.float64]: ...
    def telemetry(self) -> bytes: ...
    def release_controls(self) -> None: ...
    def control_reserved_bytes(self) -> int: ...
