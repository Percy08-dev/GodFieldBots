class StagingLease:
    def release(self) -> None: ...

class NativeSession:
    def __init__(self, plan: bytes, settings: bytes, deadline: float,
                 wall_deadline: float | None = None, cancel_handle: CancelHandle | None = None) -> None: ...
    def control_summary(self) -> bytes: ...
    def authorize(self, authorization: bytes) -> None: ...
    def next_batch(self, retained_python_bytes: int,
                   consumer_layout: tuple[int, int, int, int]) -> tuple[Any, ...] | None: ...
    def proof(self) -> bytes: ...
    def finalize(self) -> bytes: ...
    def close(self) -> None: ...
    def cancel_handle(self) -> CancelHandle: ...
    def used_bytes(self) -> int: ...
    def peak_bytes(self) -> int: ...
    def reserve_staging(self, memory_bytes: int, scratch_bytes: int) -> StagingLease: ...
    def source_hash(self, path: str) -> str: ...
    def export_staging(self, path: str, offset: int, rows: int, columns: int) -> npt.NDArray[np.float64]: ...
    def telemetry(self) -> bytes: ...
    def release_controls(self) -> None: ...
    def control_reserved_bytes(self) -> int: ...

class TreeDatasetSession:
    def __init__(self, plan: bytes, settings: bytes, deadline: float, cancel_handle: CancelHandle | None = None) -> None: ...
    def control_summary(self, retained_python_bytes: int = 0) -> bytes: ...
    def authorize_controls(self, encoded: bytes, retained_python_bytes: int = 0) -> None: ...
    def stage_next(self, retained_python_bytes: int = 0) -> bool: ...
    def collection_summary(self, retained_python_bytes: int = 0) -> bytes: ...
    def authorize_collection(self, encoded: bytes, retained_python_bytes: int = 0) -> None: ...
    def export_current(self, retained_python_bytes: int = 0) -> tuple[bytes, tuple[Any, ...], tuple[Any, ...]]: ...
    def retire_current(self, retained_python_bytes: int = 0) -> None: ...
    def verify_complete(self, retained_python_bytes: int = 0) -> bytes: ...
    def finalize(self, retained_python_bytes: int = 0) -> bytes: ...
    def recheck(self, retained_python_bytes: int = 0) -> None: ...
    def used_bytes(self) -> int: ...
    def peak_bytes(self) -> int: ...
    def control_reserved_bytes(self) -> int: ...
    def cancel_handle(self) -> CancelHandle: ...
    def close(self) -> None: ...
