class PlayerInferenceDispatcher:
    def __init__(self, capacity: int, max_batch_size: int, formation_wait_ms: float,
                 runtime_identity: str) -> None: ...
    def measurement_begin(self, encoded: bytes) -> None: ...
    def measurement_end(self, encoded: bytes) -> bytes: ...
    def enqueue(self, encoded: bytes) -> int: ...
    def next_batch(self, deadline: float) -> dict[str, Any]: ...
    def submit_results(self, batch_id: int, rows: list[dict[str, Any]]) -> int: ...
    def wait_result(self, token: int, deadline: float) -> dict[str, Any]: ...
    def retire(self, encoded: bytes) -> None: ...
    def release_game(self, run: str, trial: str, game: str) -> None: ...
    def checkpoint_references(self) -> dict[str, int]: ...
    def cancel(self, reason: str) -> None: ...
    def close(self) -> None: ...

