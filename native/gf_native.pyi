class PlayerRuntime:
    def __init__(self, encoded: bytes) -> None: ...
    def measurement_begin(self, encoded: bytes) -> None: ...
    def measurement_end(self, encoded: bytes, complete: bool = True) -> bytes: ...
    @property
    def dispatcher(self) -> PlayerInferenceDispatcher: ...
    def start(self, encoded: bytes) -> None: ...
    def next_storage(self, deadline: float) -> StorageBundle: ...
    def storage_ack(self, bundle: StorageBundle, failure: str | None = None) -> None: ...
    def storage_bytes(self) -> int: ...
    def recording_account(self) -> RecordingAccount: ...
    def wait(self, deadline: float) -> None: ...
    def completed_reports(self, keys: list[tuple[str, str, str]]) -> bytes: ...
    def quiesce(self) -> None: ...
    def cancel(self, reason: str) -> None: ...
    def join(self) -> bytes: ...
